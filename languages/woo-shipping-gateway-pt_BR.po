msgid "Delivery in %d working day"
msgid_plural "Delivery in %d working days"
msgstr[0] "Entrega em %d dia útil"
msgstr[1] "Entrega em %d dias úteis"

msgid "Invalid zip code."
msgstr "CEP inválido."

msgid "Shipping"
msgstr "Entrega"

msgid "Frenet"
msgstr "Frenet"

msgid "Frenet is a brazilian delivery method."
msgstr "Frenet é um método de entrega brasileiro."

msgid "Enable/Disable"
msgstr "Habilita/Desabilita"

msgid "Enable this shipping method"
msgstr "Ativar este método de envio"

msgid "Title"
msgstr "Título"

msgid "This controls the title which the user sees during checkout."
msgstr "Isto controla o título que o usuário vê durante o checkout."

msgid "Origin Zip Code"
msgstr "CEP de origem"

msgid "Zip Code from where the requests are sent."
msgstr "CEP de onde os pedidos são enviados."

msgid "Estimated delivery"
msgstr "Estimativa de entrega"

msgid "Enable"
msgstr "Habilitar"

msgid "Shipping Simulator"
msgstr "Simulador de frete"

msgid "Display shipping simulator in single product"
msgstr "Exibe o simulador na página do produto"

msgid "Display date of estimated delivery."
msgstr "Exibe a data de entrega estimada."

msgid "Additional days"
msgstr "Dias adicionais"

msgid "Additional days to the estimated delivery."
msgstr "Dias adicionais para a entrega estimada."

msgid "User"
msgstr "Chave de acesso"

msgid "Your Frenet access key."
msgstr "Chave de acesso ao Frenet"

msgid "Password"
msgstr "Senha de acesso"

msgid "Your Frenet access key password."
msgstr "Senha da chave de acesso ao Frenet"

msgid "Sets a minimum measure for the package."
msgstr "Defina uma medida mínima para o pacote."

msgid "Minimum Height"
msgstr "Altura Mínima"

msgid "Minimum height of the package. Frenet needs at least 2 cm."
msgstr "A altura mínima da embalagem (Valor mínimo 2 cm)."

msgid "Minimum Width"
msgstr "Largura Mínima"

msgid "Minimum width of the package. Frenet needs at least 11 cm."
msgstr "A largura mínima do pacote (Valor mínimo 11 cm)"

msgid "Minimum Length"
msgstr "Comprimento Mínimo"

msgid "Minimum length of the package. Frenet needs at least 16 cm."
msgstr "Comprimento mínimo do pacote (Valor mínimo  16 cm)."

msgid "Testing"
msgstr "Teste"

msgid "Debug Log"
msgstr "Log de depuração"

msgid "Enable logging"
msgstr "Habilitar log"

msgid "Log Frenet events, such as WebServices requests, inside %s. Quote failures are always logged to the WooCommerce log regardless of this setting."
msgstr ""
"Registrar log de eventos do Frenet, como solicitações de API, dentro do "
"arquivo %s. Falhas de cotação são sempre registradas no log do WooCommerce, "
"independente desta opção."

msgid "WooCommerce Frenet"
msgstr "WooCommerce Frenet"

msgid "Settings"
msgstr "Configurações"

msgid "WooCommerce Frenet depends on the last version of %s to work!"
msgstr "WooCommerce Frenet depende da última versão do %s para funcionar!"

msgid "WooCommerce"
msgstr "WooCommerce"

msgid "https://github.com/FrenetGatewaydeFretes/woo-shipping-gateway"
msgstr "https://github.com/FrenetGatewaydeFretes/woo-shipping-gateway"

msgid "Request Timeout (seconds)"
msgstr "Tempo Limite da Requisição (segundos)"

msgid "How long to wait for the Frenet API to respond before giving up and retrying. Recommended: between 2 and 10 seconds."
msgstr "Tempo de espera pela resposta da API da Frenet antes de desistir e tentar novamente. Recomendado: entre 2 e 10 segundos."

msgid "Request Attempts"
msgstr "Tentativas de Requisição"

msgid "How many times to try the Frenet API before giving up (1 = no retry). Each attempt can take up to the Request Timeout above, so the worst case is Attempts × Timeout."
msgstr "Quantas vezes tentar a API da Frenet antes de desistir (1 = sem nova tentativa). Cada tentativa pode levar até o Tempo Limite acima, então o pior caso é Tentativas × Tempo Limite."

msgid "Frenet shipping quote is currently unavailable. Refresh the page or re-enter the zip code to try again, or select another shipping method."
msgstr "Não foi possível calcular o frete pela Frenet no momento. Atualize a página ou informe o CEP novamente para tentar de novo, ou selecione outra forma de entrega."

msgid "Unable to confirm the Frenet shipping quote. Refresh the page or re-enter the zip code, or choose another shipping method before placing the order."
msgstr "Não foi possível confirmar o frete da Frenet. Atualize a página ou informe o CEP novamente, ou escolha outra forma de entrega antes de finalizar o pedido."

msgid "Frenet: Request Timeout must be between %2$d and %3$d seconds. %1$d was adjusted to %4$d."
msgstr "Frenet: o Tempo Limite da Requisição deve estar entre %2$d e %3$d segundos. %1$d foi ajustado para %4$d."

msgid "Frenet: Request Attempts must be between %2$d and %3$d. %1$d was adjusted to %4$d."
msgstr "Frenet: as Tentativas de Requisição devem estar entre %2$d e %3$d. %1$d foi ajustado para %4$d."
