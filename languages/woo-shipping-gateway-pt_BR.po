msgstr "Pedidos"

msgid "Import codes"
msgstr "Importar códigos"

msgid "Tracking uses the token of the Frenet shipping method. Set it in WooCommerce > Settings > Shipping > Frenet."
msgstr "O rastreio usa o token do método de entrega Frenet. Configure em WooCommerce > Configurações > Entrega > Frenet."

msgid "Add tracking codes in bulk"
msgstr "Adicionar códigos de rastreio em lote"

msgid "One order per line: order number and tracking code, separated by \";\", \",\" or a tab. You can paste two columns straight from a spreadsheet."
msgstr "Um pedido por linha: número do pedido e código de rastreio, separados por \";\", \",\" ou tabulação. Pode colar duas colunas direto de uma planilha."

msgid "Orders and codes"
msgstr "Pedidos e códigos"

